# GridFlex Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Computational Engine ─────────────────────────────────────────────────────
# Options: python | scilab | auto
# "auto" prefers Scilab when available; falls back to Python silently.
GRIDFLEX_DEFAULT_ENGINE=auto

# ── Scilab Integration (optional) ────────────────────────────────────────────
# Leave blank to auto-detect via PATH.
# Set to the full path of the scilab-cli executable if not on PATH.
# Example: GRIDFLEX_SCILAB_EXECUTABLE=/usr/bin/scilab-cli
GRIDFLEX_SCILAB_EXECUTABLE=

# Hard timeout for any Scilab subprocess call (seconds).
GRIDFLEX_SCILAB_TIMEOUT_SECONDS=30

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
